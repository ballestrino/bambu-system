generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum OperationalCostCategoryKind {
  GENERAL
  BPS
  TRANSPORT
}

model User {
  id                               String                    @id @default(cuid())
  name                             String?
  email                            String                    @unique
  emailVerified                    DateTime?
  image                            String?
  password                         String?
  role                             UserRole                  @default(USER)
  accounts                         Account[]
  isTwoFactorEnabled               Boolean                   @default(false)
  twoFactorConfirmation            TwoFactorConfirmation?
  budgets                          Budget[]
  chats                            Chat[]
  createdJobs                      Job[]                     @relation("JobCreatedBy")
  updatedJobs                      Job[]                     @relation("JobUpdatedBy")
  createdJobScheduleRules          JobScheduleRule[]         @relation("JobScheduleRuleCreatedBy")
  updatedJobScheduleRules          JobScheduleRule[]         @relation("JobScheduleRuleUpdatedBy")
  createdJobOccurrences            JobOccurrence[]           @relation("JobOccurrenceCreatedBy")
  updatedJobOccurrences            JobOccurrence[]           @relation("JobOccurrenceUpdatedBy")
  createdEmployees                 Employee[]                @relation("EmployeeCreatedBy")
  updatedEmployees                 Employee[]                @relation("EmployeeUpdatedBy")
  createdJobEmployeeAssignments    JobEmployeeAssignment[]   @relation("JobEmployeeAssignmentCreatedBy")
  updatedJobEmployeeAssignments    JobEmployeeAssignment[]   @relation("JobEmployeeAssignmentUpdatedBy")
  createdTimeEntries               TimeEntry[]               @relation("TimeEntryCreatedBy")
  updatedTimeEntries               TimeEntry[]               @relation("TimeEntryUpdatedBy")
  approvedTimeEntries              TimeEntry[]               @relation("TimeEntryApprovedBy")
  createdJobClientPayments         JobClientPayment[]        @relation("JobClientPaymentCreatedBy")
  updatedJobClientPayments         JobClientPayment[]        @relation("JobClientPaymentUpdatedBy")
  createdEmployeePayments          EmployeePayment[]         @relation("EmployeePaymentCreatedBy")
  updatedEmployeePayments          EmployeePayment[]         @relation("EmployeePaymentUpdatedBy")
  createdOperationalCostCategories OperationalCostCategory[] @relation("OperationalCostCategoryCreatedBy")
  updatedOperationalCostCategories OperationalCostCategory[] @relation("OperationalCostCategoryUpdatedBy")
  createdOperationalCosts          OperationalCost[]         @relation("OperationalCostCreatedBy")
  updatedOperationalCosts          OperationalCost[]         @relation("OperationalCostUpdatedBy")
  updatedOpsCostSettings           OpsCostSettings[]         @relation("OpsCostSettingsUpdatedBy")
  updatedMailSettings              MailSettings[]            @relation("MailSettingsUpdatedBy")
  reviewedMailSuggestions          MailSuggestion[]          @relation("MailSuggestionReviewedBy")
  approvedMailMemories             MailMemory[]              @relation("MailMemoryApprovedBy")
  createdMailRules                 MailAutoReplyRule[]       @relation("MailRuleCreatedBy")
  mailFeedback                     MailDraftFeedback[]       @relation("MailFeedbackActor")
  mailAuditEvents                  MailAuditEvent[]          @relation("MailAuditActor")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  id       String   @id @default(cuid())
  email    String
  token    String   @unique
  expires  DateTime
  oldemail String? //if( oldEmail) update the user with this email to email and set emailVerified

  @@unique([email, token])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id String @id @default(cuid())

  // optional expires, now the token is delete and every time you sign in you need to confirm

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model Budget {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  budgetOptions BudgetOption[]
  chats         Chat[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  budgetCategory BudgetCategory[]
  sourcedJobs    Job[]            @relation("JobSourceBudget")

  parentBudgetId String?
  parentBudget   Budget?  @relation("BudgetHierarchy", fields: [parentBudgetId], references: [id], onDelete: Cascade)
  childBudgets   Budget[] @relation("BudgetHierarchy")
}

model BudgetCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  budgets     Budget[]

  parentCategoryId String?
  parentCategory   BudgetCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  childCategories  BudgetCategory[] @relation("CategoryHierarchy")
}

enum VisitType {
  days
  week
  month
}

model BudgetOption {
  id              String    @id @default(cuid())
  // Info
  visits          Int
  visit_type      VisitType
  hours_per_visit Float
  nominal_hour    Float
  nominal_salary  Float
  employees       Int

  // Contributions
  incidence_contribution Float
  company_contribution   Float
  personal_contribution  Float

  // Extra costs
  transportation_cost Float
  products_price      Float
  products_iva        Float

  // Revenues
  products_revenue_percent Float
  revenue_percent          Float

  // Price
  price  Float
  profit Float? @default(0) // Made optional with default for easier migration, though ideally should be calculated
  iva    Float

  // Relations
  budgetId    String
  budget      Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  sourcedJobs Job[]  @relation("JobSourceBudgetOption")

  // Dates
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  has_products Boolean @default(true)
}

enum JobStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum JobType {
  ONGOING
  PUNCTUAL
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

enum OccurrenceStatus {
  SCHEDULED
  DONE
  SKIPPED
  CANCELED
}

enum TimeEntryStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum PaymentStatus {
  RECORDED
  VOIDED
}

model Job {
  id                   String                  @id @default(cuid())
  name                 String
  description          String?
  serviceAddress       String?
  serviceLocation      String?
  operationalNotes     String?                 @db.Text
  status               JobStatus               @default(DRAFT)
  jobType              JobType                 @default(ONGOING)
  punctualStartDate    DateTime?
  punctualEndDate      DateTime?
  budgetIncludesIva    Boolean                 @default(true)
  sourceBudgetId       String?
  sourceBudget         Budget?                 @relation("JobSourceBudget", fields: [sourceBudgetId], references: [id], onDelete: SetNull)
  sourceBudgetOptionId String?
  sourceBudgetOption   BudgetOption?           @relation("JobSourceBudgetOption", fields: [sourceBudgetOptionId], references: [id], onDelete: SetNull)
  budgetSnapshot       Json?
  archivedAt           DateTime?
  createdById          String
  createdBy            User                    @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById          String?
  updatedBy            User?                   @relation("JobUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  scheduleRules        JobScheduleRule[]
  occurrences          JobOccurrence[]
  assignments          JobEmployeeAssignment[]
  timeEntries          TimeEntry[]
  clientPayments       JobClientPayment[]
  operationalCosts     OperationalCost[]
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([status, archivedAt])
  @@index([jobType, punctualStartDate, punctualEndDate])
  @@index([sourceBudgetId])
  @@index([sourceBudgetOptionId])
  @@index([createdById])
  @@index([updatedById])
}

model JobScheduleRule {
  id               String              @id @default(cuid())
  jobId            String
  job              Job                 @relation(fields: [jobId], references: [id], onDelete: Restrict)
  isActive         Boolean             @default(true)
  frequency        RecurrenceFrequency
  interval         Int                 @default(1)
  weekdays         Int[]               @default([])
  dayOfMonth       Int?
  startDate        DateTime
  endDate          DateTime?
  startTimeMinutes Int
  durationMinutes  Int
  timezone         String              @default("America/Montevideo")
  createdById      String
  createdBy        User                @relation("JobScheduleRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById      String?
  updatedBy        User?               @relation("JobScheduleRuleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  occurrences      JobOccurrence[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([jobId, isActive])
  @@index([createdById])
  @@index([updatedById])
}

model JobOccurrence {
  id               String                  @id @default(cuid())
  jobId            String
  job              Job                     @relation(fields: [jobId], references: [id], onDelete: Restrict)
  employees        JobOccurrenceEmployee[]
  scheduleRuleId   String?
  scheduleRule     JobScheduleRule?        @relation(fields: [scheduleRuleId], references: [id], onDelete: SetNull)
  scheduledStartAt DateTime
  scheduledEndAt   DateTime
  actualStartAt    DateTime?
  actualEndAt      DateTime?
  status           OccurrenceStatus        @default(SCHEDULED)
  isDetached       Boolean                 @default(false)
  notes            String?                 @db.Text
  archivedAt       DateTime?
  createdById      String
  createdBy        User                    @relation("JobOccurrenceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById      String?
  updatedBy        User?                   @relation("JobOccurrenceUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  timeEntries      TimeEntry[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([scheduleRuleId, scheduledStartAt])
  @@index([jobId, scheduledStartAt])
  @@index([status, archivedAt])
  @@index([createdById])
  @@index([updatedById])
}

model Employee {
  id                    String                  @id @default(cuid())
  name                  String
  email                 String?
  phone                 String?
  hourlyRate            Decimal?                @db.Decimal(10, 2)
  notes                 String?                 @db.Text
  isActive              Boolean                 @default(true)
  archivedAt            DateTime?
  createdById           String
  createdBy             User                    @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById           String?
  updatedBy             User?                   @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  assignments           JobEmployeeAssignment[]
  occurrenceAssignments JobOccurrenceEmployee[]
  timeEntries           TimeEntry[]
  payments              EmployeePayment[]
  operationalCosts      OperationalCost[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([isActive, archivedAt])
  @@index([email])
  @@index([createdById])
  @@index([updatedById])
}

model JobOccurrenceEmployee {
  id              String        @id @default(cuid())
  jobOccurrenceId String
  jobOccurrence   JobOccurrence @relation(fields: [jobOccurrenceId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  @@unique([jobOccurrenceId, employeeId])
  @@index([employeeId])
  @@index([jobOccurrenceId])
}

model JobEmployeeAssignment {
  id           String    @id @default(cuid())
  jobId        String
  job          Job       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  roleLabel    String?
  assignedFrom DateTime
  assignedTo   DateTime?
  archivedAt   DateTime?
  createdById  String
  createdBy    User      @relation("JobEmployeeAssignmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById  String?
  updatedBy    User?     @relation("JobEmployeeAssignmentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([jobId, assignedFrom])
  @@index([employeeId, assignedFrom])
  @@index([createdById])
  @@index([updatedById])
}

model TimeEntry {
  id              String          @id @default(cuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id], onDelete: Restrict)
  jobOccurrenceId String?
  jobOccurrence   JobOccurrence?  @relation(fields: [jobOccurrenceId], references: [id], onDelete: SetNull)
  workDate        DateTime
  startedAt       DateTime?
  endedAt         DateTime?
  hours           Decimal         @db.Decimal(10, 2)
  status          TimeEntryStatus @default(DRAFT)
  notes           String?         @db.Text
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?           @relation("TimeEntryApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  createdById     String
  createdBy       User            @relation("TimeEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById     String?
  updatedBy       User?           @relation("TimeEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([employeeId, workDate])
  @@index([jobId, workDate])
  @@index([jobOccurrenceId])
  @@index([status, approvedAt])
  @@index([createdById])
  @@index([updatedById])
}

model JobClientPayment {
  id            String        @id @default(cuid())
  jobId         String
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Restrict)
  assignedMonth DateTime
  paymentDate   DateTime
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  notes         String?       @db.Text
  status        PaymentStatus @default(RECORDED)
  createdById   String
  createdBy     User          @relation("JobClientPaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   String?
  updatedBy     User?         @relation("JobClientPaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([jobId, assignedMonth])
  @@index([jobId, status, assignedMonth])
  @@index([jobId, paymentDate])
  @@index([status, assignedMonth])
  @@index([status, paymentDate])
  @@index([createdById])
  @@index([updatedById])
}

model EmployeePayment {
  id            String        @id @default(cuid())
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  assignedMonth DateTime
  periodStart   DateTime
  periodEnd     DateTime
  paymentDate   DateTime
  amount        Decimal       @db.Decimal(12, 2)
  reference     String?
  notes         String?       @db.Text
  status        PaymentStatus @default(RECORDED)
  createdById   String
  createdBy     User          @relation("EmployeePaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   String?
  updatedBy     User?         @relation("EmployeePaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([employeeId, assignedMonth])
  @@index([employeeId, status, assignedMonth])
  @@index([employeeId, paymentDate])
  @@index([status, assignedMonth])
  @@index([status, paymentDate])
  @@index([createdById])
  @@index([updatedById])
}

model OperationalCostCategory {
  id          String                      @id @default(cuid())
  name        String
  description String?
  color       String                      @default("#53985E")
  kind        OperationalCostCategoryKind @default(GENERAL)
  isActive    Boolean                     @default(true)
  archivedAt  DateTime?
  costs       OperationalCost[]
  createdById String
  createdBy   User                        @relation("OperationalCostCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String?
  updatedBy   User?                       @relation("OperationalCostCategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  @@unique([name])
  @@index([kind, isActive, archivedAt])
  @@index([createdById])
  @@index([updatedById])
}

model OperationalCost {
  id            String                  @id @default(cuid())
  categoryId    String
  category      OperationalCostCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  jobId         String?
  job           Job?                    @relation(fields: [jobId], references: [id], onDelete: SetNull)
  employeeId    String?
  employee      Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  assignedMonth DateTime
  costDate      DateTime
  amount        Decimal                 @db.Decimal(12, 2)
  reference     String?
  notes         String?                 @db.Text
  status        PaymentStatus           @default(RECORDED)
  createdById   String
  createdBy     User                    @relation("OperationalCostCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById   String?
  updatedBy     User?                   @relation("OperationalCostUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([categoryId, assignedMonth])
  @@index([categoryId, costDate])
  @@index([employeeId, assignedMonth])
  @@index([employeeId, costDate])
  @@index([jobId, assignedMonth])
  @@index([jobId, costDate])
  @@index([status, assignedMonth])
  @@index([status, costDate])
  @@index([createdById])
  @@index([updatedById])
}

model OpsCostSettings {
  id                 String   @id @default("default")
  bpsEstimatePercent Decimal  @default(0) @db.Decimal(5, 2)
  updatedById        String?
  updatedBy          User?    @relation("OpsCostSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([updatedById])
}

model Chat {
  id        String   @id @default(cuid())
  name      String? // Optional title for the chat
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  budgetId String?
  budget   Budget? @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  messages Message[]
}

enum Role {
  user
  assistant
  system
  data // Optional: for data messages if needed
}

model Message {
  id        String   @id @default(cuid())
  role      Role // user, assistant, system
  content   String   @db.Text // Use Text type for potentially long content
  imageUrl  String?
  createdAt DateTime @default(now())

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

enum MailDirection {
  INBOUND
  OUTBOUND
}

enum MailMessageState {
  RECEIVED
  QUEUED
  SENT
  FAILED
}

enum MailSuggestionStatus {
  PENDING
  READY
  APPROVED
  EDITED
  REJECTED
  SENT
  FAILED
}

enum MailMemoryStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum MailMemoryScope {
  STYLE
  POLICY
  CONTACT
  ORGANIZATION
}

enum MailRuleStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MailQueueStatus {
  QUEUED
  PROCESSING
  SENT
  CANCELLED
  FAILED
}

enum MailFeedbackOutcome {
  ACCEPTED
  EDITED
  REJECTED
  MANUAL_SENT
}

enum MailSyncRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

model MailSettings {
  id              String   @id @default("shared")
  autoSendEnabled Boolean  @default(false)
  signature       String?  @db.Text
  updatedById     String?
  updatedBy       User?    @relation("MailSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([updatedById])
}

model MailSyncState {
  id                 String    @id @default("shared")
  initialImportSince DateTime?
  initialImportDone  Boolean   @default(false)
  leaseToken         String?
  leaseUntil         DateTime?
  lastSuccessAt      DateTime?
  lastError          String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model MailFolderCursor {
  id                    String    @id @default(cuid())
  folderKey             String    @unique
  displayName           String
  uidValidity           String?
  lastUid               String?
  initialImportComplete Boolean   @default(false)
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model MailSyncRun {
  id              String            @id @default(cuid())
  source          String
  status          MailSyncRunStatus @default(RUNNING)
  importedCount   Int               @default(0)
  updatedCount    Int               @default(0)
  skippedCount    Int               @default(0)
  suggestionCount Int               @default(0)
  error           String?           @db.Text
  startedAt       DateTime          @default(now())
  finishedAt      DateTime?

  @@index([startedAt])
  @@index([status, startedAt])
}

model MailThread {
  id                String        @id @default(cuid())
  threadKey         String        @unique
  subject           String
  normalizedSubject String
  participantEmails String[]
  lastMessageAt     DateTime
  lastInboundAt     DateTime?
  unreadCount       Int           @default(0)
  isArchived        Boolean       @default(false)
  messages          MailMessage[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([lastMessageAt])
  @@index([isArchived, lastMessageAt])
  @@index([unreadCount, lastMessageAt])
}

model MailMessage {
  id                String                       @id @default(cuid())
  threadId          String
  thread            MailThread                   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  folderKey         String
  uidValidity       String
  providerUid       String
  internetMessageId String?
  inReplyTo         String?
  referenceIds      String[]
  direction         MailDirection
  state             MailMessageState
  fromAddress       String
  fromName          String?
  toAddresses       String[]
  ccAddresses       String[]
  bccAddresses      String[]
  subject           String
  bodyText          String                       @db.Text
  bodyHtml          String?                      @db.Text
  receivedAt        DateTime?
  sentAt            DateTime?
  isRead            Boolean                      @default(false)
  isArchived        Boolean                      @default(false)
  hasAttachments    Boolean                      @default(false)
  requiresHandoff   Boolean                      @default(false)
  autoSubmitted     String?
  listId            String?
  headers           Json?
  embedding         Unsupported("vector(1536)")?
  attachments       MailAttachment[]
  suggestion        MailSuggestion?
  feedback          MailDraftFeedback[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  @@unique([folderKey, uidValidity, providerUid])
  @@index([threadId, receivedAt])
  @@index([threadId, sentAt])
  @@index([internetMessageId])
  @@index([direction, state])
  @@index([isRead, isArchived])
}

model MailAttachment {
  id             String      @id @default(cuid())
  messageId      String
  message        MailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename       String
  mimeType       String
  sizeBytes      Int
  contentId      String?
  providerPartId String?
  createdAt      DateTime    @default(now())

  @@index([messageId])
}

model MailSuggestion {
  id                   String               @id @default(cuid())
  messageId            String               @unique
  message              MailMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status               MailSuggestionStatus @default(PENDING)
  reasoningEffort      String               @default("high")
  intent               String?
  isComplex            Boolean              @default(false)
  riskLevel            String?
  confidence           Float?
  safetyConfidence     Float?
  manualReviewRequired Boolean              @default(true)
  subject              String?
  body                 String?              @db.Text
  reasons              String[]
  protectedLiterals    String[]
  error                String?              @db.Text
  reviewedById         String?
  reviewedBy           User?                @relation("MailSuggestionReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  reviewedAt           DateTime?
  feedback             MailDraftFeedback[]
  queueItems           MailAutoReplyQueue[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([reviewedById])
}

model MailMemory {
  id              String                       @id @default(cuid())
  scope           MailMemoryScope
  status          MailMemoryStatus             @default(PENDING)
  key             String
  value           String                       @db.Text
  contactEmail    String?
  sourceMessageId String?
  validUntil      DateTime?
  embedding       Unsupported("vector(1536)")?
  approvedById    String?
  approvedBy      User?                        @relation("MailMemoryApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt      DateTime?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([status, scope])
  @@index([contactEmail, status])
  @@index([approvedById])
}

model MailAutoReplyRule {
  id                     String                       @id @default(cuid())
  name                   String
  status                 MailRuleStatus               @default(ACTIVE)
  exampleMessageId       String
  exampleReplySubject    String
  exampleReplyBody       String                       @db.Text
  normalizedInputHash    String
  intent                 String
  similarityThreshold    Float                        @default(0.95)
  protectedLiterals      String[]
  allowContextAdaptation Boolean                      @default(true)
  embedding              Unsupported("vector(1536)")?
  createdById            String
  createdBy              User                         @relation("MailRuleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  queueItems             MailAutoReplyQueue[]
  lastMatchedAt          DateTime?
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt

  @@index([status, intent])
  @@index([normalizedInputHash])
  @@index([createdById])
}

model MailAutoReplyQueue {
  id               String            @id @default(cuid())
  inboundMessageId String            @unique
  ruleId           String
  rule             MailAutoReplyRule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  suggestionId     String
  suggestion       MailSuggestion    @relation(fields: [suggestionId], references: [id], onDelete: Restrict)
  status           MailQueueStatus   @default(QUEUED)
  scheduledFor     DateTime
  idempotencyKey   String            @unique
  leaseUntil       DateTime?
  attempts         Int               @default(0)
  cancelReason     String?
  lastError        String?           @db.Text
  sentMessageId    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status, scheduledFor])
  @@index([ruleId])
  @@index([suggestionId])
}

model MailDraftFeedback {
  id              String              @id @default(cuid())
  suggestionId    String?
  suggestion      MailSuggestion?     @relation(fields: [suggestionId], references: [id], onDelete: SetNull)
  sourceMessageId String?
  sourceMessage   MailMessage?        @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)
  actorId         String
  actor           User                @relation("MailFeedbackActor", fields: [actorId], references: [id], onDelete: Restrict)
  outcome         MailFeedbackOutcome
  originalBody    String?             @db.Text
  finalBody       String?             @db.Text
  createdAt       DateTime            @default(now())

  @@index([suggestionId])
  @@index([sourceMessageId])
  @@index([actorId, createdAt])
}

model MailAuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("MailAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
